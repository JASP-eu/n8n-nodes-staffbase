{
	"name": "n8n-nodes-staffbase",
	"version": "0.1.0",
	"description": "n8n community node for the Staffbase API: news posts, channels, users and comments",
	"license": "MIT",
	"homepage": "https://github.com/JASP-eu/n8n-nodes-staffbase#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"staffbase",
		"employee-app",
		"intranet"
	],
	"author": {
		"name": "JASP",
		"email": "info@jasp.eu",
		"url": "https://jasp.eu"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/JASP-eu/n8n-nodes-staffbase.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"typecheck": "tsc -p tsconfig.test.json",
		"test": "vitest run",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/StaffbaseApi.credentials.js",
			"dist/credentials/StaffbaseWebhookApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Staffbase/Staffbase.node.js",
			"dist/nodes/StaffbaseTrigger/StaffbaseTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.56.3",
		"eslint": "9.39.4",
		"n8n-workflow": "2.16.0",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "7.0.2",
		"vitest": "5.1.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
